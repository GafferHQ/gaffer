Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["renderSettingOverrides_depthOfField"], 'description', 'Overrides the `render:depthOfField` option:\n\nWhether to render with depth of field. To ensure the effect is\nvisible, you must also set an f-stop value greater than 0 on\nthis camera.' )
Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["renderSettingOverrides_depthOfField"], 'nameValuePlugPlugValueWidget:ignoreNamePlug', True )
