Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["renderSettingOverrides_filmFit"]["value"], 'presetNames', IECore.StringVectorData( [ 'Horizontal', 'Vertical', 'Fit', 'Fill', 'Distort' ] ) )
Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["renderSettingOverrides_filmFit"]["value"], 'presetValues', IECore.IntVectorData( [ 0, 1, 2, 3, 4 ] ) )
