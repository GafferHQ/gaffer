Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["fStop"], 'nodule:type', '' )
Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["fStop"], 'description', 'The setting equivalent to the f-number on a camera, which ultimately determines the strength of the depth of field blur. A lower value produces more blur. As in a real camera, `fStop` is defined as `focalLength / lens aperture`.\n\nTo enable depth of field blur (if your renderer supports it), give this plug a value greater than 0, and, on a downstream StandardOptions node, enable the _Depth Of Field_ plug and turn it on.' )
Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["fStop"], 'layout:section', 'Depth of Field' )
Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["fStop"], 'layout:index', 24 )
Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["fStop"], 'layout:visibilityActivator', 'typeIsFisheye' )
Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["focalLengthWorldScale"], 'nodule:type', '' )
Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["focalLengthWorldScale"], 'description', "The scale to convert from focal length units to world space\nunits. Combined with f-stop to calculate the lens aperture.\nSet this to scale the lens units into scene units, to\nensure the depth of field blur correctly scales to the\nscene. Once this plug is set, the `fStop` plug can be\nadjusted to match a real-world lens setting.\n\nFor example, given a lens with a focal length in mm, and a\nscene that uses decimeters for its world space units, the\n_Millimeters to Decimeters_ preset would provide the proper\nconversion.\n\nThe default value of 0.1 scales millimeter (default focal\nlength unit) to centimeter (default world space unit of\nAlembic and USD scene formats). Other default presets for\nscaling to decimeter or meter are also available.\n\nIf using _Field Of View_ projection mode, you won't have a\nfocal length plug to work with, and the aperture size will\nbe (1,1). To compensate, select _Custom_ and then input a\nvalue that scales the scene unit of measure to a realistic\naperture size. For example, `3.5` would convert 1\ncentimeter (Alembic/USD default) to 35mm, which would\nsimulate a 35mm lens." )
Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["focalLengthWorldScale"], 'preset:No Conversion\t   ( 1.0 )', 1.0 )
Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["focalLengthWorldScale"], 'preset:Millimeters to Centimeters\t   ( 0.1 )', 0.10000000149011612 )
Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["focalLengthWorldScale"], 'preset:Millimeters to Decimeters\t   ( 0.01 )', 0.009999999776482582 )
Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["focalLengthWorldScale"], 'preset:Millimeters to Meters\t   ( 0.001 )', 0.0010000000474974513 )
Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["focalLengthWorldScale"], 'presetsPlugValueWidget:allowCustom', True )
Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["focalLengthWorldScale"], 'plugValueWidget:type', 'GafferUI.PresetsPlugValueWidget' )
Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["focalLengthWorldScale"], 'layout:section', 'Depth of Field' )
Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["focalLengthWorldScale"], 'layout:index', 25 )
Gaffer.Metadata.registerValue( __children["ArnoldCamera"]["focalLengthWorldScale"], 'layout:visibilityActivator', 'typeIsFisheye' )
