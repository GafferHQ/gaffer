Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypesMode"], 'preset:Primitive Variable', 1 )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypesMode"], 'preset:None', 2 )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypesMode"], 'description', 'Determines the locations of the prototypes to be instanced.\n\n- List : The `prototypesList` plug is used to explicitly define the prototype locations.\n- PrimitiveVariable : The `prototypesPrimitiveVariable` plug is used to name an existing primitive variable which contains the list of prototype locations.\n- None : The prototype locations are assumed to already be defined on the input object. This mode can be used to add prototype variation to an existing PointInstancer.\n\nThe locations will be stored on the output PointInstancer object as a constant primitive variable named `prototypeRoots`. This may be modified downstream prior to rendering, using nodes such as PrimitiveVariableTweaks.' )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypesMode"], 'label', 'Mode' )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypeIndexMode"], 'nodule:type', '' )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypeIndexMode"], 'layout:section', 'Settings.Prototypes' )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypeIndexMode"], 'plugValueWidget:type', 'GafferUI.PresetsPlugValueWidget' )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypeIndexMode"], 'layout:index', 6 )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypeIndexMode"], 'label', 'Index Mode' )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypeIndexMode"], 'preset:Constant', 0 )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypeIndexMode"], 'preset:Random', 1 )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypeIndexMode"], 'preset:Primitive Variable', 2 )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypeIndexMode"], 'preset:None', 3 )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypeIndexMode"], 'description', 'Determines the per-point index used to determine which prototype is instanced onto each point.\n\n- Constant : All points reference the same prototype, specified by the `prototypeIndex` plug.\n- Random : Prototypes are assigned randomly to points, with a uniform weighting. If more specific weightings are required, use the PrimitiveVariable mode with an upstream RandomPrimitiveVariable.\n- Primitive Variable : The `prototypeIndexPrimitiveVariable` is used to define the indices.\n- None : The input primitive is assumed to already have indices. This mode can be used to add prototype variation to an existing PointInstancer.\n\nThe indices will be stored on the output PointInstancer object as a vertex primitive variable named `prototypeIndex`. This may be modified downstream prior to rendering, using nodes such as PrimitiveVariableTweaks.' )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["contextVariables"], 'nodule:type', '' )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["contextVariables"], 'layout:section', 'Settings.Prototype Variation' )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["contextVariables"], 'layout:index', 9 )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["contextVariables"], 'description', "The names of per-vertex primitive variables on the input object that will be turned into context variables when evaluating the `prototypes` scene. A new prototype will be generated for each unique combination of context variable values.\n\nNames should be separated by spaces, and Gaffer's standard wildcards may be used.\n\n> Tip : Consider using a QuantizePrimitiveVariables node to limit the number of unique prototype variations. In the extreme, if every point had a different combination of primitive variables, there would be a unique prototype per point and there would be no instancing." )
__children["PointInstancer"]["timeOffset"].setValue( 'timeOffset' )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["timeOffset"], 'nodule:type', '' )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["timeOffset"], 'layout:section', 'Settings.Prototype Variation' )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["timeOffset"], 'layout:index', 10 )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["timeOffset"], 'description', 'The name of a float primitive variable defining a time offset per point. Each unique time offset is used to define a new variation of the input prototype.\n\n> Tip : Consider using a QuantizePrimitiveVariables node to limit the number of unique prototype variations. In the extreme, if every point had a different time offset, there would be a unique prototype per point and there would be no instancing.' )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypeFormat"], 'nodule:type', '' )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypeFormat"], 'layout:activator', 'prototypeVariationsActive' )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypeFormat"], 'layout:section', 'Settings.Prototype Variation' )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypeFormat"], 'layout:index', 11 )
Gaffer.Metadata.registerValue( __children["PointInstancer"]["prototypeFormat"], 'description', "A format specification used to customise the name of each prototype based on its context variables and time offset. The following format tokens are available :\n\n- `{name}` : The original prototype name before variation.\n- `{timeOffset}` : The time offset.\n- `{contextVariable}` : The value of a context variable.\n- `{hash}` : A hash value that uniquely identifies the prototype.\n\n> Note : Each prototype must have a unique name. If the time offset or any context variable is omitted from the format, the hash will be appended automatically to maintain this constraint.\n\n> Note : Special rules apply when formatting floating point values such as the time offset.\n> The '.' and '-' characters are not legal in USD identifiers, so to produce names that are\n> compatible with USD they are replaced with '_' and 'n' respectively." )
