__children["PointInstancer"]["ApplyPrototypeIndex"]["Expression"]["__engine"].setValue( 'python' )
__children["PointInstancer"]["ApplyPrototypeIndex"]["Expression"]["__expression"].setValue( 'parent["__out"]["p0"] = max( 0, len( parent["__in"]["p0"] ) - 1 )' )
__children["PointInstancer"]["Expression"]["__engine"].setValue( 'python' )
__children["PointInstancer"]["Expression"]["__expression"].setValue( '# Get the path to the source location for this prototype,\n# and make sure it is absolute.\n## \\todo This is needed when adding variation to an existing\n# instancer, but I\'m not sure it\'s that useful for anything else.\n# Maybe we should move this case to a secondary PrototypeVariations\n# node?\n\nprototype = parent["__in"]["p0"]\n\nif not prototype.startswith( "/" ) :\n\tif prototype.startswith( "./" ) :\n\t\tprototype = prototype[2:]\n\tprototype = "{}/{}".format(\n\t\tcontext.get( "__pointInstancer:parentLocation", "" ),\n\t\tprototype\n\t)\n\nparent["__out"]["p0"] = prototype' )
__children["PointInstancer"]["Expression1"]["__engine"].setValue( 'python' )
__children["PointInstancer"]["Expression1"]["__expression"].setValue( 'parent["__out"]["p0"] = "prototypeRoots prototypeIndex P scale orientation instanceId invisibleIds " + parent["__in"]["p0"]\n' )
